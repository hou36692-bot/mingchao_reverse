float3 direction=normalize(TangentWorld*oct.x+BitangentWorld*oct.y+NormalWorld*oct.z);
float3 forward=float3(0.9975630875833955,0,-0.0697702392935752);
float3 right=float3(0,1,0),up=float3(0.0697702392935752,0,0.9975630875833955);
float tanX=0.4663076102733612,tanY=0.26229801774024963;
float2 projected=float2(dot(direction,right)/tanX,dot(direction,up)/tanY);
projected/=max(length(projected),0.000001);
float thickness=lerp(WidthFloor,1,VertexG)*Width*WidthScale;
float2 raw=projected*thickness*0.1*(0.767327/tanY);
float viewDepth=max(dot(WorldPosition-ReferenceCamera,forward),0.001);
float2 perPixel=2*viewDepth/float2(3840,2160);
float2 target=clamp(abs(raw),perPixel,perPixel*999);
float2 s=saturate(abs(raw)/max(perPixel*WidthClamp*0.1,0.000001));s=s*s*(3-2*s);
float2 offset=lerp(abs(raw),target,s)*sign(raw);
float3 result=right*offset.x*tanX+up*offset.y*tanY;
result+=normalize(WorldPosition-ReferenceCamera)*(VertexB*DepthBias*DepthScale*0.01);
return result;
}