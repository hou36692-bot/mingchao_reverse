float3 SR_ReferenceOutline(float2 UV1,float VertexG,float VertexB,float3 TangentWorld,float3 BitangentWorld,float3 NormalWorld,float3 WorldPosition,float3 ReferenceCamera,float WidthFloor,float Width,float WidthClamp,float WidthScale,float DepthBias,float DepthScale){
// E655 VS 245-340: octahedral direction, vertex G width and B depth offset.
float3 oct=float3(UV1,1-abs(UV1.x)-abs(UV1.y));
